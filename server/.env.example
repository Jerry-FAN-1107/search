# ===== 环境变量示例：复制为 .env 后填写真实值。绝不要把 .env 提交进 Git。 =====

# 应用
APP_ENV=development            # production 启用严格校验（弱 JWT 密钥将拒绝启动）
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据库（MySQL）
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/enterprise_consult?charset=utf8mb4

# 认证：必须注入强随机密钥（openssl rand -hex 32 生成）
JWT_SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=5

# 豆包（火山方舟 OpenAI 兼容接口，仅后端持有，禁止暴露给前端）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=
DOUBAO_THINKING_MODEL=
DOUBAO_EMBEDDING_MODEL=

# 本地 embedding（Ollama OpenAI 兼容端点）
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama

# RAG
CHROMA_PERSIST_DIR=./chroma_data
RAG_TOP_K=6
RAG_RECALL_TOP_K=20
RAG_SIMILARITY_THRESHOLD=0.65
RAG_RERANK_ENABLED=true

# HITL / LangGraph checkpoint（SQLite 落盘，重启可恢复）
GRAPH_CHECKPOINT_DB=./graph_state.db
HITL_ENABLED=true

# 多轮对话滑动窗口（轮数）
MAX_HISTORY_TURNS=6

# LLM 流控
LLM_PER_USER_RPM=20
LLM_GLOBAL_CONCURRENCY=8

# 内容安全
CONTENT_MODERATION_ENABLED=true
SENSITIVE_WORDS_FILE=./sensitive_words.txt
PROMPT_INJECTION_GUARD=true

# 文件
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# 可观测性（可选）
SENTRY_DSN=
METRICS_ENABLED=false

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs
